+/* Tint rejects the SPIR-V Component decoration, so widen signature masks that do not start at x (e.g. v0.zw
+ * becomes v0.xyzw). The variable then always starts at component 0. */
+static void spirv_widen_signature_mask(const struct signature_element *element)
+{
+    struct signature_element *e = (struct signature_element *)element;
+    unsigned int hi;
+
+    if (!e->mask || (e->mask & 1))
+        return;
+    for (hi = 3; hi > 0 && !(e->mask & (1u << hi)); --hi)
+        ;
+    e->mask = (2u << hi) - 1;
+}
